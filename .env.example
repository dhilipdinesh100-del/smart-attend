# ==============================================================================
# SmartAttend Production Environment Configuration Example
# Copy this file to .env (do NOT commit .env to version control)
# ==============================================================================

# Core Application Security
SECRET_KEY=generate-a-secure-random-secret-key-for-production-min-32-chars
QR_SECRET_SALT=optional-dedicated-salt-for-qr-code-checksums

# Server Configuration
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=0

# Session Configuration
SESSION_COOKIE_SECURE=0
